<?xml version="1.0" encoding="utf-8" standalone="yes"?>
<settings>
  <category label="Accounts">
    <setting id="resolveurl_settings" type="action" label="Open ResolveURL Settings" action="Addon.OpenSettings(script.module.resolveurl)" option="close" />
    <setting type="lsep" label="Provider authorization, enable/disable, and cached-only settings are managed by ResolveURL" />
  </category>

  <category label="Search &amp; source filters">
    <setting id="max_quality" type="enum" label="Maximum quality" values="4K|1080p|720p|SD" default="0" />
    <setting id="max_size_gb" type="enum" label="Maximum torrent size" values="1 GB|2 GB|3 GB|4 GB|5 GB|6 GB|7 GB|8 GB|9 GB|10 GB|Unlimited" default="10" />
    <setting id="source_limit" type="slider" label="Maximum torrent results" default="80" range="20,20,200" option="int" />
    <setting id="metadata_base" type="text" label="Metadata endpoint" default="https://v3-cinemeta.strem.io" />
    <setting id="source_base" type="text" label="Torrent source endpoint" default="https://torrentio.strem.fun" />
  </category>

  <category label="Playback">
    <setting id="auto_fallback" type="bool" label="Automatically try the next torrent if playback fails" default="true" />
    <setting id="wrap_fallback" type="bool" label="After the bottom of the list, wrap to the top" default="true" enable="eq(-1,true)" />
    <setting id="startup_timeout" type="slider" label="Playback startup timeout (seconds)" default="15" range="5,5,60" option="int" />
    <setting id="uncached_wait" type="slider" label="Maximum wait for uncached torrent (seconds)" default="120" range="30,30,600" option="int" />
    <setting id="auto_cleanup_playback" type="bool" label="Automatically remove temporary torrents after playback" default="true" />
  </category>

  <category label="Downloads">
    <setting id="download_path" type="folder" label="Save To" default="special://home/../" />
    <setting id="create_media_folders" type="bool" label="Create title/season folders" default="true" />
  </category>

  <category label="Maintenance">
    <setting id="reset_defaults" type="action" label="Reset all settings to defaults"
             action="RunPlugin(plugin://plugin.video.premiumplayer/?action=reset_defaults)" option="close" />
    <setting type="lsep" label="ResolveURL account authorizations are managed separately and are not reset" />
  </category>

  <category label="Advanced">
    <setting id="debug" type="bool" label="Debug logging" default="false" />
    <setting id="terms_agreed" type="bool" label="Internal" default="false" visible="false" />
    <setting id="terms_version" type="text" label="Internal" default="" visible="false" />
    <setting id="resolveurl_migration_done" type="bool" label="Internal" default="false" visible="false" />
    <!-- Legacy 0.1.0-0.1.3 credential slots retained only for one-time migration. -->
    <setting id="rd_enabled" type="bool" label="Internal" default="true" visible="false" />
    <setting id="rd_cached_only" type="bool" label="Internal" default="true" visible="false" />
    <setting id="rd_client_id" type="text" label="Internal" default="" visible="false" />
    <setting id="rd_client_secret" type="text" label="Internal" default="" visible="false" />
    <setting id="rd_access_token" type="text" label="Internal" default="" visible="false" />
    <setting id="rd_refresh_token" type="text" label="Internal" default="" visible="false" />
    <setting id="rd_token_expires" type="text" label="Internal" default="0" visible="false" />
    <setting id="rd_username" type="text" label="Internal" default="" visible="false" />
    <setting id="tb_enabled" type="bool" label="Internal" default="true" visible="false" />
    <setting id="tb_cached_only" type="bool" label="Internal" default="true" visible="false" />
    <setting id="tb_token" type="text" label="Internal" default="" visible="false" />
    <setting id="tb_username" type="text" label="Internal" default="" visible="false" />
  </category>
</settings>
