<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="plugin.video.thesportssearch" name="The Sports Search" version="2.9.34" provider-name="mrfixit2001">
  <requires>
    <import addon="xbmc.python" version="3.0.0" />
    <import addon="inputstream.adaptive" optional="true" />
  </requires>
  <extension point="xbmc.python.pluginsource" library="default.py">
    <provides>video</provides>
  </extension>
  <extension point="xbmc.addon.metadata">
    <summary lang="en_GB">Search free, currently live sports streams</summary>
    <description lang="en_GB">Searches anonymous, free live sports sources and resolves streams at playback time. No replays, debrid services, external playback add-ons, accounts, telemetry, or background services.</description>
    <platform>all</platform>
    <language>en</language>
    <license>GPL-2.0-or-later</license>
    <assets>
      <icon>icon.png</icon>
      <fanart>fanart.jpg</fanart>
    </assets>
  </extension>
</addon>
